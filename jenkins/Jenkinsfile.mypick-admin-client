// mypick-admin-client 전용 배포 파이프라인
// MyPick 관리자 클라이언트의 빌드, 테스트, 배포를 관리합니다.

@Library('krgeobuk-shared-library') _

pipeline {
    agent any

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'prod'],
            description: '배포 환경'
        )
        string(
            name: 'GIT_BRANCH',
            defaultValue: 'dev',
            description: 'Git 브랜치 (dev: dev 브랜치, prod: main 브랜치)'
        )
        booleanParam(
            name: 'SKIP_TESTS',
            defaultValue: false,
            description: '테스트 건너뛰기'
        )
        booleanParam(
            name: 'RUN_E2E_TESTS',
            defaultValue: false,
            description: 'E2E 테스트 실행'
        )
    }

    environment {
        SERVICE_NAME = 'mypick-admin-client'
        DOCKER_REGISTRY = 'krgeobuk'
        DOCKER_CREDENTIALS_ID = 'docker-registry-credentials'

        // Git 설정
        GIT_REPO = "https://github.com/${env.GITHUB_ORG}/mypick-admin-client.git"
        GIT_CREDENTIALS_ID = 'github-credentials'

        // 빌드 정보
        BUILD_TIMESTAMP = sh(script: "date +%Y%m%d-%H%M%S", returnStdout: true).trim()
        GIT_COMMIT_SHORT = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()

        // 이미지 태그: dev는 latest, prod는 timestamp
        IMAGE_TAG = params.ENVIRONMENT == 'dev' ? 'latest' : "${BUILD_TIMESTAMP}-${GIT_COMMIT_SHORT}"

        // K8s 설정
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '30'))
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
    }

    // ============================================================================
    // GitHub Webhook 자동 빌드 설정 (주석 해제 후 사용)
    // ============================================================================
    // GitHub에서 push 또는 PR 이벤트 발생 시 자동으로 빌드를 트리거합니다.
    //
    // 사용 방법:
    // 1. Jenkins 설정:
    //    - Jenkins > Manage Jenkins > Configure System
    //    - GitHub Server 추가 및 Credentials 설정
    //    - GitHub Plugin 설치 확인
    //
    // 2. GitHub Webhook 설정:
    //    - GitHub 리포지토리 > Settings > Webhooks > Add webhook
    //    - Payload URL: http://your-jenkins-url/github-webhook/
    //    - Content type: application/json
    //    - Events: Push events, Pull requests
    //
    // 3. 아래 주석 해제:
    //    triggers 블록의 주석을 제거하고 사용
    //
    // 주의사항:
    //    - Jenkins가 인터넷에서 접근 가능해야 함 (포트 포워딩 또는 ngrok 등)
    //    - GitHub Webhook Secret 설정 권장 (보안)
    // ============================================================================

    /*
    triggers {
        // GitHub webhook을 통한 자동 빌드
        githubPush()

        // 또는 특정 브랜치에 대해서만 트리거 (선택사항)
        // GenericTrigger(
        //     genericVariables: [
        //         [key: 'ref', value: '$.ref']
        //     ],
        //     causeString: 'Triggered by GitHub push',
        //     token: 'mypick-admin-client-webhook-token',
        //     printContributedVariables: true,
        //     printPostContent: true,
        //     regexpFilterText: '$ref',
        //     regexpFilterExpression: 'refs/heads/(dev|main)'
        // )
    }
    */

    stages {
        stage('📋 Prepare') {
            steps {
                script {
                    load("jenkins/config/${params.ENVIRONMENT}.groovy")
                    echo """
                    =========================================
                    mypick-admin-client 배포 파이프라인
                    =========================================
                    환경: ${params.ENVIRONMENT}
                    브랜치: ${params.GIT_BRANCH}
                    네임스페이스: ${env.K8S_NAMESPACE}
                    이미지 태그: ${env.IMAGE_TAG}
                    =========================================
                    """
                }
            }
        }

        stage('🔍 Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "*/${params.GIT_BRANCH}"]],
                    userRemoteConfigs: [[
                        url: env.GIT_REPO,
                        credentialsId: env.GIT_CREDENTIALS_ID
                    ]]
                ])
            }
        }

        stage('📦 Install Dependencies') {
            steps {
                sh '''
                    echo "Installing dependencies..."
                    npm ci
                '''
            }
        }

        stage('🧪 Run Tests') {
            when {
                expression { !params.SKIP_TESTS }
            }
            parallel {
                stage('Unit Tests') {
                    steps {
                        sh '''
                            echo "Running unit tests..."
                            npm run test
                        '''
                    }
                }
                stage('Lint') {
                    steps {
                        sh '''
                            echo "Running linter..."
                            npm run lint
                        '''
                    }
                }
            }
        }

        stage('🧪 E2E Tests') {
            when {
                expression { params.RUN_E2E_TESTS }
            }
            steps {
                sh '''
                    echo "Running E2E tests..."
                    npm run test:e2e
                '''
            }
        }

        stage('🏗️ Build') {
            steps {
                sh '''
                    echo "Building application..."
                    npm run build
                '''
            }
        }

        stage('🐳 Build Docker Image') {
            steps {
                script {
                    if (params.ENVIRONMENT == 'dev') {
                        // dev 환경: 로컬 이미지 빌드 후 k3s containerd에 import
                        // imagePullPolicy: Never 이므로 k3s containerd에 직접 적재 필요
                        echo "Building local Docker image for dev environment..."
                        sh """
                            docker build -t ${env.SERVICE_NAME}:latest .
                            echo "✓ Local image built: ${env.SERVICE_NAME}:latest"

                            echo "Importing image to k3s containerd..."
                            docker save ${env.SERVICE_NAME}:latest | \
                                k3s ctr images import --namespace k8s.io -
                            echo "✓ Image imported to k3s: ${env.SERVICE_NAME}:latest"
                        """
                    } else {
                        // prod 환경: Registry에 push
                        echo "Building and pushing Docker image for prod environment..."
                        buildImage(
                            serviceName: env.SERVICE_NAME,
                            imageTag: env.IMAGE_TAG,
                            dockerRegistry: env.DOCKER_REGISTRY,
                            additionalTags: ['latest']
                        )
                    }
                }
            }
        }

        stage('🚀 Deploy to Kubernetes') {
            steps {
                script {
                    // Production 배포는 수동 승인 필요
                    if (env.MANUAL_APPROVAL.toBoolean()) {
                        input message: 'Production 환경에 배포하시겠습니까?',
                              ok: 'Deploy to Production',
                              submitter: 'admin,devops'
                    }

                    // K8s 배포
                    deployToK8s(
                        environment: params.ENVIRONMENT,
                        service: env.SERVICE_NAME,
                        imageTag: env.IMAGE_TAG,
                        namespace: env.K8S_NAMESPACE
                    )
                }
            }
        }

        stage('✅ Verify Deployment') {
            steps {
                script {
                    echo "Verifying deployment..."
                    sh """
                        kubectl rollout status deployment/${env.SERVICE_NAME} -n ${env.K8S_NAMESPACE} --timeout=5m
                        kubectl get pods -n ${env.K8S_NAMESPACE} -l app=${env.SERVICE_NAME}
                    """
                }
            }
        }

        stage('🔍 Health Check') {
            steps {
                script {
                    echo "Running health check..."
                    sh """
                        # Pod가 Ready 상태인지 확인
                        kubectl wait --for=condition=ready pod -l app=${env.SERVICE_NAME} -n ${env.K8S_NAMESPACE} --timeout=300s

                        # HTTP 응답 확인 (Next.js 클라이언트)
                        POD_NAME=\$(kubectl get pod -n ${env.K8S_NAMESPACE} -l app=${env.SERVICE_NAME} -o jsonpath='{.items[0].metadata.name}')
                        kubectl exec \$POD_NAME -n ${env.K8S_NAMESPACE} -- curl -f http://localhost:3310/ || exit 1
                    """
                }
            }
        }
    }

    post {
        success {
            script {
                notifySlack(
                    status: 'SUCCESS',
                    channel: env.SLACK_CHANNEL,
                    environment: params.ENVIRONMENT,
                    service: env.SERVICE_NAME,
                    message: """
                    ✅ mypick-admin-client 배포 성공
                    환경: ${params.ENVIRONMENT}
                    이미지: ${env.DOCKER_REGISTRY}/${env.SERVICE_NAME}:${env.IMAGE_TAG}
                    네임스페이스: ${env.K8S_NAMESPACE}
                    """.stripIndent()
                )
            }
        }
        failure {
            script {
                notifySlack(
                    status: 'FAILURE',
                    channel: env.SLACK_CHANNEL,
                    environment: params.ENVIRONMENT,
                    service: env.SERVICE_NAME,
                    message: """
                    ❌ mypick-admin-client 배포 실패
                    환경: ${params.ENVIRONMENT}
                    에러 확인: ${env.BUILD_URL}console
                    """.stripIndent()
                )
            }
        }
        always {
            // 테스트 결과 보관
            junit allowEmptyResults: true, testResults: '**/test-results/**/*.xml'

            // 빌드 아티팩트 정리
            cleanWs(
                deleteDirs: true,
                patterns: [
                    [pattern: 'node_modules', type: 'INCLUDE'],
                    [pattern: '.next', type: 'INCLUDE'],
                    [pattern: 'out', type: 'INCLUDE']
                ]
            )
        }
    }
}
